[Unit]
Description=MeshDesk Mesh VPN Node
Documentation=https://github.com/yzy806806/meshdesk
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=root
Group=root

# Binary location
ExecStart=/usr/local/bin/meshdesk --config /etc/meshdesk/config.yaml

# Enable web UI mode by uncommenting:
# ExecStart=/usr/local/bin/meshdesk --config /etc/meshdesk/config.yaml --web

# Restart policy — always restart so smux auto-reconnect has a chance
# even if the process crashes unexpectedly.
Restart=always
RestartSec=5
StartLimitBurst=10
StartLimitIntervalSec=60

# Watchdog: meshdesk sends WATCHDOG=1 pings every 15s via sd_notify.
# If no ping arrives within 45s, systemd considers the process hung
# and restarts it. The 3:1 ratio gives the process time to recover
# from transient network stalls without being killed prematurely.
WatchdogSec=45

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=meshdesk

# Security hardening
NoNewPrivileges=false
ProtectSystem=false
ProtectHome=false

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
