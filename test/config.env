# MeshDesk Test Configuration
# Copy this to config.env.local and adjust for your environment.
#
# Usage: source test/config.env

# --- Node Inventory ---
# At least 3 nodes are required for full scenario coverage.
# Format: NODE<n>_HOST, NODE<n>_ROLE, NODE<n>_SSH_KEY
# Roles: public-vps, behind-nat, cross-region, collector, agent

# Node 1: Public VPS (collector + web UI entry point)
NODE1_HOST=test-node1.example.com
NODE1_ROLE=public-vps
NODE1_SSH_KEY=~/.ssh/meshdesk_test_node1

# Node 2: Behind NAT / firewall (agent)
NODE2_HOST=test-node2.example.com
NODE2_ROLE=behind-nat
NODE2_SSH_KEY=~/.ssh/meshdesk_test_node2

# Node 3: Cross-region (agent, tests latency / packet loss tolerance)
NODE3_HOST=test-node3.example.com
NODE3_ROLE=cross-region
NODE3_SSH_KEY=~/.ssh/meshdesk_test_node3

# Optional: Additional nodes for large-scale tests
# NODE4_HOST=test-node4.example.com
# NODE4_ROLE=agent
# NODE4_SSH_KEY=~/.ssh/meshdesk_test_node4

# --- Docker Cluster Settings ---
# Used by docker-compose.yml for local simulation
DOCKER_NODE1_PORT=51820
DOCKER_NODE2_PORT=51821
DOCKER_NODE3_PORT=51822

# Simulated latency between nodes (ms, via tc netem)
SIM_LATENCY_N1_N2=20
SIM_LATENCY_N1_N3=150
SIM_LATENCY_N2_N3=100

# Packet loss simulation (percentage, 0-100)
SIM_PACKET_LOSS=0

# --- Test Matrix Settings ---
# Timeout for individual scenario (seconds)
SCENARIO_TIMEOUT=300
# Output directory for test results
RESULTS_DIR=./test/results
# JSON report filename
REPORT_FILE=test_report.json

# --- MeshDesk Binary ---
# Path to the meshdesk binary (set automatically by scenario-matrix.sh if empty)
MESHDESK_BIN=./meshdesk

# --- GFW Simulation (Docker only, via iptables) ---
# Enable iptables-based DPI simulation (approximate)
SIM_GFW=0
# Block pattern for GFW simulation
SIM_GFW_PATTERN="WireGuard"